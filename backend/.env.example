# Nova@Gen Technologies - Backend Environment Variables
# Copy this file to .env and provide your MongoDB Atlas connection string

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/novagen_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/novagen_db?retryWrites=true&w=majority

# Application Port (Default 8080)
PORT=8080
